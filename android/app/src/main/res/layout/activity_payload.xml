<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generador de Payloads"
            android:textColor="@color/primary_electric"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Configura bugs de operadoras para evadir restricciones de datos"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Host Bug Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="URL / Bug Host (ej: portal.operadora.com)"
            android:textColorHint="@color/text_secondary"
            app:boxStrokeColor="@color/primary_electric"
            app:hintTextColor="@color/primary_electric">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBugHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Método de Inyección -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MÉTODO DE PETICIÓN"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spMethod"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/primary_electric" />

        <!-- Tipo de Inyección -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODO DE INYECCIÓN"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spInjectionType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/primary_electric" />

        <!-- Opciones de Cabecera (Checkboxes / Switches) -->
        <CheckBox
            android:id="@+id/cbOnlineHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Online Host (X-Online-Host)"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/cbKeepAlive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Keep-Alive"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/cbForwardHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forward Host (X-Forward-Host)"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/cbUserAgent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="User-Agent dinámico"
            android:textColor="@color/text_primary" />

        <!-- Botones de Generación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnGeneratePayload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_electric"
                android:text="Generar HTTP"
                android:textColor="@color/bg_main" />

            <Button
                android:id="@+id/btnGenerateWs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/accent_neon"
                android:text="Generar CDN WS"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- Preview del Payload Generado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESULTADO DEL PAYLOAD"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPayloadResult"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/badge_disconnected"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:padding="12dp"
            android:textColor="@color/primary_electric"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnApplyPayload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/status_green"
            android:text="GUARDAR Y APLICAR AL PERFIL"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
